# Copy this file to .env (or export these as real environment variables)
# and adjust as needed. Every value below is optional -- these are the
# built-in defaults.

# --- LLM backend (Ollama) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
MODEL_NAME=llama3.1
# Vision model for handwriting only. llama3.2-vision is 7.8 GB; on a
# memory-constrained machine granite3.2-vision (2.4 GB) is far more likely
# to load alongside the text model. Can also be overridden per request with
# the vision_model form field on /upload.
VISION_MODEL_NAME=llama3.2-vision
ENABLE_HANDWRITING=false
HANDWRITING_MIN_CONFIDENCE=0.65
VISION_TIMEOUT_SECONDS=900

# --- Ground truth (resume few-shot examples) ---
GROUND_TRUTH_PATH=./ground_truth_resumes.json

# --- Limits ---
MAX_FILE_SIZE=10485760
MAX_PROMPT_CHARACTERS=24000
MAX_EXAMPLES=2
# Per-attempt timeout. Note this is per HTTP attempt, and OLLAMA_MAX_RETRIES
# multiplies it: at 480s with 2 retries, a hard failure takes 3 x 480s = 24
# minutes before you see the error. Raising this makes a genuine failure
# slower to surface, so prefer fixing the underlying speed problem
# (OLLAMA_NUM_CTX below) first.
REQUEST_TIMEOUT_SECONDS=480
OLLAMA_MAX_RETRIES=2

# Biggest lever on memory use and therefore speed. The KV cache scales
# linearly with this (~128 KB/token for an 8B model: ~4 GB at 32768 vs
# ~1 GB at 8192). A typical resume prompt is only ~2800 tokens, so a large
# window buys nothing but memory pressure. Drop to 8192 if the machine is
# RAM-constrained; do not go below ~12288 if you process long reports.
OLLAMA_NUM_CTX=16384
ENABLE_REPAIR_PASS=true

# --- OCR (only needed on Windows if tesseract isn't on PATH) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
